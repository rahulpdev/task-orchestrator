{
	"name": "task-orchestrator",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"license": "Elastic-2.0",
	"packageManager": "pnpm@12.18.0",
	"engines": {
		"node": ">=26"
	},
	"scripts": {
		"build": "pnpm typecheck && pnpm --filter @task-orchestrator/plugin run build",
		"dev": "pnpm --filter @task-orchestrator/plugin run dev",
		"lint": "eslint . --max-warnings 0 && node scripts/check-core-boundary.ts",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"typecheck": "pnpm -r run typecheck && tsc --noEmit -p tsconfig.json && tsc --noEmit -p e2e-tests/tsconfig.json",
		"test": "vitest run",
		"e2e": "pnpm build && wdio run e2e-tests/wdio.conf.mts",
		"check:manifest": "node scripts/check-manifest.ts",
		"version": "node scripts/version-bump.ts && git add manifest.json versions.json packages/*/package.json",
		"check:size": "node scripts/check-bundle-size.ts"
	},
	"devDependencies": {
		"@types/mocha": "^10.0.10",
		"@types/node": "^26.6.6",
		"@vitest/coverage-v8": "^5.1.0",
		"@wdio/cli": "^10.2.0",
		"@wdio/globals": "^10.2.0",
		"@wdio/local-runner": "^10.2.0",
		"@wdio/mocha-framework": "^10.2.0",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-import-resolver-typescript": "^4.4.5",
		"eslint-plugin-import-x": "^4.18.1",
		"eslint-plugin-obsidianmd": "0.5.1",
		"jiti": "^2.7.0",
		"mocha": "^12.0.3",
		"prettier": "^3.9.10",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.72.2",
		"vite": "^8.3.7",
		"vitest": "^5.1.0",
		"wdio-obsidian-reporter": "^3.5.0",
		"wdio-obsidian-service": "^3.5.0"
	}
}
